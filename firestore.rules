rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userName() {
      return request.auth.token.email == 'shivaan@fivezone.app' ? 'Shivaan' :
             request.auth.token.email == 'aryan@fivezone.app' ? 'Aryan' :
             request.auth.token.email == 'ahaan@fivezone.app' ? 'Ahaan' :
             request.auth.token.email == 'varun@fivezone.app' ? 'Varun' :
             request.auth.token.email == 'jashn@fivezone.app' ? 'Jashn' : null;
    }

    function allowedUser() { return signedIn() && userName() != null; }

    match /messages/{messageId} {
      allow read: if allowedUser();
      allow create: if allowedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name == userName()
        && request.resource.data.text is string
        && request.resource.data.ts is number
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    match /statuses/{friendName} {
      allow read: if allowedUser();
      allow create, update: if allowedUser()
        && friendName == userName()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status in ['Available', 'Busy', 'Sleeping', 'Away']
        && request.resource.data.ts is number;
      allow delete: if false;
    }

    match /meta/next_call {
      allow read: if allowedUser();
      allow create, update: if allowedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.when is string;
      allow delete: if false;
    }
  }
}