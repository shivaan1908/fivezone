rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.name is string && request.resource.data.text is string && request.resource.data.ts is number && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }
    match /statuses/{friendName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.status in ['Available', 'Busy', 'Sleeping', 'Away'] && request.resource.data.ts is number;
      allow delete: if false;
    }
    match /meta/next_call { allow read, write: if signedIn(); }
  }
}